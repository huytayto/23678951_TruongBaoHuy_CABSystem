
@startuml
title Microservices Architecture - Vertical Layout

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 75
skinparam ranksep 95
skinparam padding 12
skinparam ArrowThickness 1.4
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle

skinparam component {
  RoundCorner 12
  BorderColor #5488B8
  FontColor #202020
}
skinparam database {
  BorderColor #5488B8
  FontColor #202020
}
skinparam package {
  BorderColor #B7B7B7
  FontColor #202020
}

' ==================================================
' LAYER 1 - CLIENT
' ==================================================
rectangle "CLIENT\n\nWeb | Tablet | Smartphone" as CLIENT #D9ECFF

' ==================================================
' LAYER 2 - API GATEWAY AND CACHE
' ==================================================
rectangle "API GATEWAY\n\nAuthentication & Authorization\nRequest Routing\nRate Limiting\nLogging & Monitoring" as GW #F0DFFF

database "Redis - API Gateway DB\n\nToken Cache\nSession Storage\nRate Limiting\nData Cache" as REDIS #FFE4E4

CLIENT -down-> GW : REST API\nHTTPS / JSON
GW <-right-> REDIS : Cache / Session

' ==================================================
' LAYER 3 - MICROSERVICES
' ==================================================
together {
  component "Auth Service\n\nAccount Management\nAuthentication & Authorization\nRole Management" as AUTH #D9EEFF

  component "Customer Service\n\nCustomer Information\nMembership Management\nLoyalty Score" as CUSTOMER #D7F9D9

  component "Order Service\n\nOrder Management\nDiscount Calculation\nOrder Details\nPublish Order Events" as ORDER #FFDADA

  component "Product Service\n\nProduct Management\nInventory Validation & Update\nProduct Information" as PRODUCT #FFF0C2

  component "Shipment Service\n\nOrder Reception\nDelivery Status Updates\nShipment Management" as SHIPMENT #EAD9FF
}

' Force services to stay in one row
AUTH -[hidden]right-> CUSTOMER
CUSTOMER -[hidden]right-> ORDER
ORDER -[hidden]right-> PRODUCT
PRODUCT -[hidden]right-> SHIPMENT

' Gateway to services
GW -down-> AUTH : gRPC
GW -down-> CUSTOMER : gRPC
GW -down-> ORDER : gRPC
GW -down-> PRODUCT : gRPC
GW -down-> SHIPMENT : gRPC

' ==================================================
' LAYER 4 - DATABASES
' ==================================================
together {
  database "PostgreSQL\nAuth DB\n\nUser\nRole" as AUTH_DB #EAF3FF

  database "PostgreSQL\nCustomer DB\n\nCustomer\nMembership" as CUSTOMER_DB #E4FFE7

  database "PostgreSQL\nOrder DB\n\nOrder\nOrderDetail" as ORDER_DB #FFE5E5

  database "MongoDB\nProduct DB\n\nProduct\nInventory" as PRODUCT_DB #FFF5D9

  database "MongoDB\nShipment DB\n\nShipment\nTracking" as SHIPMENT_DB #F0DFFF
}

' Align each database under its service
AUTH -down-> AUTH_DB : SQL
CUSTOMER -down-> CUSTOMER_DB : SQL
ORDER -down-> ORDER_DB : SQL
PRODUCT -down-> PRODUCT_DB : Document access
SHIPMENT -down-> SHIPMENT_DB : Document access

AUTH_DB -[hidden]right-> CUSTOMER_DB
CUSTOMER_DB -[hidden]right-> ORDER_DB
ORDER_DB -[hidden]right-> PRODUCT_DB
PRODUCT_DB -[hidden]right-> SHIPMENT_DB

' ==================================================
' SERVICE-TO-SERVICE SYNCHRONOUS COMMUNICATION
' ==================================================
CUSTOMER <--> ORDER : gRPC
ORDER <--> PRODUCT : gRPC

' ==================================================
' LAYER 5 - ASYNCHRONOUS EVENT BROKER
' ==================================================
queue "KAFKA - Message Broker\n\norder-created\nOther topics" as KAFKA #F0DFFF

ORDER_DB -[hidden]down-> KAFKA
ORDER -[#D71920,dashed]down-> KAFKA : Publish\nOrder Created Event

KAFKA -[#D71920,dashed]right-> SHIPMENT : Consume\nOrder Created Event

' ==================================================
' LEGEND
' ==================================================
legend bottom
  |= Style |= Meaning |
  | <color:#2676D2>━━━ → ━━━</color> | REST API / synchronous gRPC |
  | <color:#D71920>┄┄┄ → ┄┄┄</color> | Kafka asynchronous event |
  | <color:#202020>━━━ ↔ ━━━</color> | Database / cache connection |
endlegend

@enduml
